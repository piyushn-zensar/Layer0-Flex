# Copy to .env and adjust. Never commit .env.

# mock  = use cached model answers only (data/llm_cache/). No key needed. Default.
# azure = call Azure OpenAI for cache misses, then cache the answer (frozen first pass).
LLM_PROVIDER=mock
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Tesseract OCR executable (parsing machine only; default: %LOCALAPPDATA%\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=

# Sign-in accounts database. With MYSQL_HOST set, accounts live in MySQL (MYSQL_DB is created on first start);
# without it, in the local SQLite store. Passwords are stored hashed.
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=layer0
# Starting password of every account seeded from data/accounts.json. Changing it later does not change existing
# accounts: use .venv\Scripts\python -m scripts.set_password <username>
DEMO_PASSWORD=layer0-demo
# Long random value that signs the sign-in tokens. Empty = one made per machine in data/store/jwt_secret.
JWT_SECRET=

# DATABASE_URL=sqlite:///data/store/layer0.db
